{"case_id": "CNV-001", "input": "single new email from an unknown sender", "context": {"steps": [{"channel": "email", "payload": {"From": "stranger@unknown.example", "Subject": "Outstanding balance", "Message-ID": "<n1@x>", "Date": "2026-08-14T09:00:00Z", "text": "how much do I owe?"}}]}, "expected": {"conversations": 1, "messages": 1, "created": [true], "thread_resolved_by": ["new"], "customer_resolved": [false]}, "tags": ["email", "unknown_customer"]}
{"case_id": "CNV-002", "input": "email reply threads onto the original via In-Reply-To", "context": {"steps": [{"channel": "email", "payload": {"From": "stranger@unknown.example", "Subject": "Outstanding balance", "Message-ID": "<t1@x>", "Date": "2026-08-14T09:00:00Z", "text": "how much do I owe?"}}, {"channel": "email", "payload": {"From": "stranger@unknown.example", "Subject": "Re: Outstanding balance", "Message-ID": "<t2@x>", "In-Reply-To": "<t1@x>", "Date": "2026-08-14T11:00:00Z", "text": "any update?"}}]}, "expected": {"conversations": 1, "messages": 2, "created": [true, true], "thread_resolved_by": ["new", "in_reply_to"]}, "tags": ["email", "threading"]}
{"case_id": "CNV-003", "input": "the same email delivered twice", "context": {"steps": [{"channel": "email", "payload": {"From": "stranger@unknown.example", "Subject": "Duplicate", "Message-ID": "<d1@x>", "Date": "2026-08-14T09:00:00Z", "text": "hello"}}, {"channel": "email", "payload": {"From": "stranger@unknown.example", "Subject": "Duplicate", "Message-ID": "<d1@x>", "Date": "2026-08-14T09:00:00Z", "text": "hello"}}]}, "expected": {"conversations": 1, "messages": 1, "created": [true, false]}, "tags": ["email", "duplicate"]}
{"case_id": "CNV-004", "input": "the same webhook delivered twice", "context": {"steps": [{"channel": "webhook", "payload": {"delivery_id": "dlv-7", "session_id": "s7", "phone": "8109410408", "text": "I want to return 20 pieces", "timestamp": "2026-08-14T09:00:00Z"}}, {"channel": "webhook", "payload": {"delivery_id": "dlv-7", "session_id": "s7", "phone": "8109410408", "text": "I want to return 20 pieces", "timestamp": "2026-08-14T09:00:00Z"}}]}, "expected": {"conversations": 1, "messages": 1, "created": [true, false], "customer_resolved": [true, true]}, "tags": ["webhook", "duplicate", "idempotency"]}
{"case_id": "CNV-005", "input": "chat session continues across messages", "context": {"steps": [{"channel": "chat", "payload": {"message_id": "c1", "session_id": "sess-1", "phone": "8109410408", "text": "hi", "timestamp": "2026-08-14T09:00:00Z"}}, {"channel": "chat", "payload": {"message_id": "c2", "session_id": "sess-1", "phone": "8109410408", "text": "what is my balance?", "timestamp": "2026-08-14T09:05:00Z"}}]}, "expected": {"conversations": 1, "messages": 2, "thread_resolved_by": ["new", "thread_key"], "customer_resolved": [true, true]}, "tags": ["chat", "threading"]}
{"case_id": "CNV-006", "input": "two chat sessions from one customer stay separate", "context": {"steps": [{"channel": "chat", "payload": {"message_id": "a1", "session_id": "sess-a", "phone": "8109410408", "text": "first topic", "timestamp": "2026-08-14T09:00:00Z"}}, {"channel": "chat", "payload": {"message_id": "b1", "session_id": "sess-b", "phone": "8109410408", "text": "second topic", "timestamp": "2026-08-14T10:00:00Z"}}]}, "expected": {"conversations": 2, "messages": 2, "customer_resolved": [true, true]}, "tags": ["chat", "multiple_conversations"]}
{"case_id": "CNV-007", "input": "sender resolves to a real customer by mobile", "context": {"steps": [{"channel": "chat", "payload": {"message_id": "r1", "session_id": "sr", "phone": "8109410408", "text": "balance please", "timestamp": "2026-08-14T09:00:00Z"}}]}, "expected": {"conversations": 1, "messages": 1, "customer_resolved": [true], "customer_ids": ["6a6464a09f707bd30403549f"], "resolved_by": ["mobile"]}, "tags": ["resolution", "mobile"]}
{"case_id": "CNV-008", "input": "a mobile shared by three customers is not guessed", "context": {"steps": [{"channel": "chat", "payload": {"message_id": "amb1", "session_id": "samb", "phone": "9424885200", "text": "balance please", "timestamp": "2026-08-14T09:00:00Z"}}]}, "expected": {"conversations": 1, "messages": 1, "customer_resolved": [false], "resolved_by": ["mobile_ambiguous"]}, "tags": ["resolution", "ambiguous", "adversarial"]}
{"case_id": "CNV-009", "input": "customer replies from a new address and stays on the thread", "context": {"steps": [{"channel": "email", "payload": {"From": "8109410408", "Subject": "Ledger query", "Message-ID": "<e1@x>", "Date": "2026-08-14T09:00:00Z", "text": "from the known address"}}, {"channel": "email", "payload": {"From": "brand-new@elsewhere.example", "Subject": "Re: Ledger query", "Message-ID": "<e2@x>", "In-Reply-To": "<e1@x>", "Date": "2026-08-14T10:00:00Z", "text": "same person, new address"}}]}, "expected": {"conversations": 1, "messages": 2, "customer_resolved": [true, true], "customer_ids": ["6a6464a09f707bd30403549f", "6a6464a09f707bd30403549f"]}, "tags": ["email", "identity", "changed_address"]}
{"case_id": "CNV-010", "input": "out-of-order arrival still reads back chronologically", "context": {"steps": [{"channel": "email", "payload": {"From": "stranger@unknown.example", "Subject": "Ordering", "Message-ID": "<o2@x>", "Date": "2026-08-14T12:00:00Z", "text": "later message, arrived first"}}, {"channel": "email", "payload": {"From": "stranger@unknown.example", "Subject": "Re: Ordering", "Message-ID": "<o1@x>", "In-Reply-To": "<o2@x>", "Date": "2026-08-14T10:00:00Z", "text": "earlier message, arrived second"}}]}, "expected": {"conversations": 1, "messages": 2, "chronological": true, "first_message_text": "earlier message, arrived second"}, "tags": ["email", "out_of_order"]}
{"case_id": "CNV-011", "input": "a retried delivery with no id deduplicates on content", "context": {"steps": [{"channel": "chat", "payload": {"session_id": "noid", "phone": "8109410408", "text": "no delivery id here", "timestamp": "2026-08-14T09:00:00Z"}}, {"channel": "chat", "payload": {"session_id": "noid", "phone": "8109410408", "text": "no delivery id here", "timestamp": "2026-08-14T09:00:00Z"}}]}, "expected": {"conversations": 1, "messages": 1, "created": [true, false]}, "tags": ["chat", "duplicate", "no_delivery_id"]}
{"case_id": "CNV-012", "input": "an anonymous thread adopts the customer once identified", "context": {"steps": [{"channel": "email", "payload": {"From": "mystery@unknown.example", "Subject": "Who am I", "Message-ID": "<m1@x>", "Date": "2026-08-14T09:00:00Z", "text": "hello"}}, {"channel": "email", "payload": {"From": "8109410408", "Subject": "Re: Who am I", "Message-ID": "<m2@x>", "In-Reply-To": "<m1@x>", "Date": "2026-08-14T10:00:00Z", "text": "it is me"}}]}, "expected": {"conversations": 1, "messages": 2, "customer_resolved": [false, true], "conversation_customer_id": "6a6464a09f707bd30403549f"}, "tags": ["email", "identity", "backfill"]}
{"case_id": "CNV-013", "input": "all three channels land in one common representation", "context": {"steps": [{"channel": "email", "payload": {"From": "8109410408", "Subject": "Mixed", "Message-ID": "<x1@x>", "Date": "2026-08-14T09:00:00Z", "text": "via email"}}, {"channel": "chat", "payload": {"message_id": "x2", "session_id": "sx", "phone": "8109410408", "text": "via chat", "timestamp": "2026-08-14T09:01:00Z"}}, {"channel": "webhook", "payload": {"delivery_id": "x3", "session_id": "sw", "phone": "8109410408", "text": "via webhook", "timestamp": "2026-08-14T09:02:00Z"}}]}, "expected": {"conversations": 3, "messages": 3, "created": [true, true, true], "customer_resolved": [true, true, true], "channels": ["email", "chat", "webhook"]}, "tags": ["exit_criteria", "all_channels"]}
